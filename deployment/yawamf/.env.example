# Stable official CPU image; keep this matched to the downloaded Compose release.
YAWAMF_MONALITHIC_TAG=v2.23.2-cpu
DOCKER_NETWORK=birdcam_default
APP_BIND_IP=127.0.0.1
APP_PORT=9852
TZ=America/New_York
# IDs are for the Linux container and its managed volumes, not Windows accounts.
PUID=1000
PGID=1000
FRIGATE_URL=http://birdcam-frigate-1:5000
FRIGATE_AUTH_TOKEN=
MQTT_SERVER=birdnet-mqtt
MQTT_PORT=1883
MQTT_AUTH=false
MQTT_USERNAME=
MQTT_PASSWORD=
CLASSIFIER_IMAGE_MAX_CONCURRENT=1
CLASSIFIER_IMAGE_ADMISSION_TIMEOUT_SECONDS=5
FRIGATE__CLIPS_ENABLED=false
